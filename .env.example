# Copy to .env and fill in. Never commit .env.

# This app's own database
DB_HOST=localhost
DB_NAME=jenn_db
DB_USERNAME=jenn_user
DB_PASSWORD=change-me

# Job postings (https://rapidapi.com → JSearch). Without a key, sample jobs are used.
RAPIDAPI_KEY=

# University SIS (read-only). Use a database user that only has SELECT on this schema.
UNI_DB_HOST=localhost
UNI_DB_NAME=campus_dynamics
UNI_DB_USERNAME=sis_reader
UNI_DB_PASSWORD=change-me

# Portal sign-in. Leave UNI_AUTH_MODE unset in production: university accounts are checked against the
# portal password hashes. "dev" lets every university account use DEV_LOGIN_PASSWORD; demo/staging only.
# UNI_AUTH_MODE=dev
# DEV_LOGIN_PASSWORD=

# Time zone for logs and dates (default Africa/Kampala)
# APP_TIMEZONE=Africa/Kampala
